# macOS
.DS_Store

# 依赖与构建产物
node_modules/
.next/
out/
build/

# 日志
npm-debug.log*
yarn-error.log*

# 编辑器
.vscode/
.idea/

# wrangler 部署缓存（本地产物，不入库）
.wrangler/

# 剧本明文（构建中间产物）——新站绝不入库
# 注意：xishan/working/ 是历史已跟踪文件（《西山不是山》本就全文公开），
# .gitignore 只管未跟踪文件，不影响它继续发布。
*/working/
working/

# 本机构建输出（含 working/ 剧本明文，绝不入库）
outputs/

# 阅读密码（保险起见）
.readpass

# 建站工具链的字体缓存（构建时生成，产物已进 px1928/assets/fonts/）
.cache/
tools/script-site/.cache/
