{
  "name": "Nocturne · 剧目展演站",
  "version": "1.0.0",
  "source": "参考视频逐帧像素采样（非目测）",
  "color": {
    "red": {
      "value": "#FF0000",
      "role": "幕布正红 — 视频主色",
      "sampled": true
    },
    "redDeep": {
      "value": "#BF0002",
      "role": "幕布暗部",
      "sampled": true
    },
    "redLift": {
      "value": "#FF2A2A",
      "role": "高光红",
      "sampled": false
    },
    "paper": {
      "value": "#F8F2E8",
      "role": "宣纸米白",
      "sampled": true
    },
    "paperPure": {
      "value": "#FFFFFF",
      "role": "纯白 — 瓶盖高光",
      "sampled": true
    },
    "paperWarm": {
      "value": "#F2E9E3",
      "role": "浅米白",
      "sampled": true
    },
    "ink": {
      "value": "#0E0D12",
      "role": "墨黑",
      "sampled": true
    },
    "inkSoft": {
      "value": "#2A2A30",
      "role": "深灰",
      "sampled": false
    },
    "inkMute": {
      "value": "#6B6B72",
      "role": "中灰",
      "sampled": false
    },
    "rule": {
      "value": "#C9C0BA",
      "role": "纸面分隔线",
      "sampled": false
    },
    "ruleDark": {
      "value": "#7A1414",
      "role": "红面分隔线",
      "sampled": false
    },
    "bottleBlue": {
      "value": "#4FB6F9",
      "role": "瓶身蓝",
      "sampled": true
    },
    "bottleGreen": {
      "value": "#91EA82",
      "role": "瓶身绿",
      "sampled": true
    },
    "bottleYellow": {
      "value": "#FDDE1F",
      "role": "瓶身黄",
      "sampled": true
    }
  },
  "typography": {
    "display": {
      "family": "Noto Serif SC",
      "fallback": "Songti SC, serif",
      "role": "蚀刻巨标题",
      "scale": {
        "hero": {
          "size": 176,
          "lineHeight": 0.94,
          "tracking": "-0.02em"
        },
        "displayL": {
          "size": 96,
          "lineHeight": 1.0,
          "tracking": "0"
        },
        "displayM": {
          "size": 64,
          "lineHeight": 1.05,
          "tracking": "0"
        },
        "displayS": {
          "size": 40,
          "lineHeight": 1.12,
          "tracking": "0"
        }
      }
    },
    "latin": {
      "family": "Bodoni Moda",
      "fallback": "Didot, serif",
      "role": "拉丁 Didone / 副题与剧目拉丁名"
    },
    "script": {
      "family": "Pinyon Script",
      "fallback": "Snell Roundhand, cursive",
      "role": "手写签名 / 剧作家落款"
    },
    "body": {
      "family": "Noto Serif SC",
      "role": "正文",
      "scale": {
        "title": {
          "size": 28,
          "lineHeight": 1.3
        },
        "lead": {
          "size": 19,
          "lineHeight": 1.75
        },
        "body": {
          "size": 16,
          "lineHeight": 1.85
        },
        "caption": {
          "size": 13,
          "lineHeight": 1.6
        }
      }
    },
    "label": {
      "family": "Noto Sans SC",
      "role": "导航 / 标签 / 数据",
      "size": 11,
      "lineHeight": 1.2,
      "tracking": "0.28em"
    }
  },
  "spacing": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32,
    "7": 48,
    "8": 64,
    "9": 96,
    "10": 128,
    "11": 160,
    "note": "4 的倍数阶"
  },
  "radius": {
    "none": 0,
    "micro": 2,
    "note": "全站直角，仅 1px 描边块允许 2px"
  },
  "stroke": {
    "hair": 0.5,
    "thin": 1,
    "medium": 1.5,
    "thick": 2.5
  },
  "layout": {
    "pageWidth": 1440,
    "pagePadding": 96,
    "measure": 640
  },
  "motion": {
    "easeOut": "cubic-bezier(0.16, 1, 0.3, 1)",
    "easeSoft": "cubic-bezier(0.4, 0, 0.2, 1)",
    "duration": {
      "fast": 240,
      "mid": 520,
      "slow": 900
    }
  },
  "texture": {
    "engraving": {
      "name": "铜版画排线",
      "level": "1px 级细密刻线（视频实测观感）",
      "fine": {
        "gap": "3.0-5.0px",
        "width": "0.45-0.6px",
        "opacity": "0.09-0.24",
        "use": "大面积色块表面"
      },
      "mid": {
        "gap": "3.4px",
        "width": "0.45px",
        "opacity": "0.16",
        "use": "形体转折"
      },
      "bold": {
        "gap": "2.6px",
        "width": "0.45px",
        "opacity": "0.24",
        "use": "轮廓与深阴影"
      },
      "note": "若隐若现为关键 —— 过密会糊成灰面"
    },
    "handDrawn": {
      "name": "手绘抖动",
      "implementation": "排线位置与线宽随空间位置波动（jitter），模拟运笔压力"
    }
  }
}