{
  "name": "Nocturne · 剧目展演站",
  "version": "1.0.0",
  "source": "抖音样片《这个我愿称之为年度伟大发现》实测采样 + 铜版画戏单语汇延展",
  "color": {
    "curtain":      { "value": "#B00000", "role": "品牌主色 / 幕布正红", "sampled": true },
    "curtainDeep":  { "value": "#7C0000", "role": "排线阴影 / 暗部", "sampled": false },
    "curtainLift":  { "value": "#C81E1E", "role": "高光强调", "sampled": false },
    "paper":        { "value": "#E0D9D6", "role": "米白 / 反白文字", "sampled": true },
    "paperWarm":    { "value": "#EFE9E5", "role": "浅米白 / 交替区块", "sampled": false },
    "ink":          { "value": "#08080A", "role": "墨黑 / 正文", "sampled": true },
    "inkSoft":      { "value": "#3A342E", "role": "次级文字", "sampled": false },
    "inkMute":      { "value": "#6B635C", "role": "辅助信息", "sampled": false },
    "rule":         { "value": "#C9C0BA", "role": "纸面分隔线", "sampled": false },
    "ruleDark":     { "value": "#5E1818", "role": "红面分隔线", "sampled": false }
  },
  "typography": {
    "display": {
      "family": "Noto Serif SC",
      "fallback": "Songti SC, serif",
      "role": "蚀刻巨标题",
      "scale": {
        "hero":      { "size": 176, "lineHeight": 0.94, "tracking": "-0.02em" },
        "displayL":  { "size": 96,  "lineHeight": 1.00, "tracking": "0" },
        "displayM":  { "size": 64,  "lineHeight": 1.05, "tracking": "0" },
        "displayS":  { "size": 40,  "lineHeight": 1.12, "tracking": "0" }
      }
    },
    "latin": {
      "family": "Bodoni Moda",
      "fallback": "Didot, serif",
      "role": "拉丁 Didone / 副题与剧目拉丁名"
    },
    "script": {
      "family": "Pinyon Script",
      "fallback": "Snell Roundhand, cursive",
      "role": "手写签名 / 剧作家落款"
    },
    "body": {
      "family": "Noto Serif SC",
      "role": "正文",
      "scale": {
        "title":   { "size": 28, "lineHeight": 1.30 },
        "lead":    { "size": 19, "lineHeight": 1.75 },
        "body":    { "size": 16, "lineHeight": 1.85 },
        "caption": { "size": 13, "lineHeight": 1.60 }
      }
    },
    "label": {
      "family": "Noto Sans SC",
      "role": "导航 / 标签 / 数据",
      "size": 11,
      "lineHeight": 1.20,
      "tracking": "0.28em"
    }
  },
  "spacing": {
    "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32,
    "7": 48, "8": 64, "9": 96, "10": 128, "11": 160,
    "note": "4 的倍数阶"
  },
  "radius": { "none": 0, "micro": 2, "note": "全站直角，仅 1px 描边块允许 2px" },
  "stroke": { "hair": 0.5, "thin": 1, "medium": 1.5, "thick": 2.5 },
  "layout": { "pageWidth": 1440, "pagePadding": 96, "measure": 640 },
  "motion": {
    "easeOut": "cubic-bezier(0.16, 1, 0.3, 1)",
    "easeSoft": "cubic-bezier(0.4, 0, 0.2, 1)",
    "duration": { "fast": 240, "mid": 520, "slow": 900 }
  },
  "texture": {
    "engraving": {
      "name": "铜版画排线",
      "implementation": "SVG feTurbulence + feDisplacementMap 生成手绘抖动；feColorMatrix 提取排线密度",
      "lineWeightPx": 0.8,
      "lineGapPx": 3.2,
      "angleDeg": 45,
      "levels": 5
    },
    "erodeTitle": {
      "name": "标题侵蚀",
      "implementation": "SVG mask + feTurbulence(baseFrequency 0.9) 做字面缺口；Ardot 画布用错版套印 + 细划痕叠加近似",
      "offsetPx": 1.5
    },
    "paperGrain": {
      "name": "纸纹颗粒",
      "implementation": "SVG feTurbulence type=fractalNoise baseFrequency=0.8 + feColorMatrix 转灰度叠加，opacity 0.06"
    }
  }
}
